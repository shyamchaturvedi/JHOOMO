{
  "rules": {
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth.uid === $uid"
      }
    },
    "typing": {
      "$chatId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth.uid === $uid",
          ".validate": "newData.hasChildren(['at'])"
        }
      }
    }
  }
}
